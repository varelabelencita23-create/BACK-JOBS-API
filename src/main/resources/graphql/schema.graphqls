type Query {
    assigneds(request: AssignRequest): [UserJobAssigned]
    userById(id:ID): User
    jobById(id: ID!): Job
}
type Mutation {
    addJob(request: JobRequest): Job
    addUser(request: UserRequest): CreatedUser
}

type UserJobAssigned {
    users: [User]
    job: Job
}

type User {
    id: ID
    firstName: String
    lastName: String
    email:String
    job:Job

}

type Job {
    name:String
    salary:Float
    hours:Float
    id:ID
    resources:Float
}

input UserRequest {
    name: String!
    job: String!
}

type CreatedUser {
    id: ID!
    name: String!
    job: String!
    createdAt: String!
}

input AssignRequest {
    requestNumber: Int
    clientName: String
}

input JobRequest {
    name: String
    salary: Float
    hours: Float
    resources: Float
}
